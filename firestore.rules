rules_version = '2';

// Regole di sicurezza Firestore per ReadFolio.
//
// Principio: ogni utente possiede e gestisce SOLO i propri dati. Le funzionalità
// social aprono in modo CONTROLLATO la lettura della libreria altrui:
//   - sempre per il proprietario;
//   - per chiunque se il profilo è pubblico;
//   - per i soli follower "accepted" se il profilo è privato;
//   - MAI per chi è stato bloccato.
//
// L'autorizzazione vera vive qui, non nell'app: il client può solo provare a
// leggere/scrivere, è il server a concedere o negare.
//
// Deploy:  firebase deploy --only firestore:rules
// Test:    firebase emulators:start --only firestore
//
// NOTA: abilitare anche Firebase App Check per bloccare client non autentici.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Il profilo pubblico esiste ed è marcato pubblico.
    function profileIsPublic(userId) {
      return exists(/databases/$(database)/documents/publicProfiles/$(userId))
        && get(/databases/$(database)/documents/publicProfiles/$(userId)).data.isPublic == true;
    }

    // L'approvazione è legata alla privacy: profilo privato ⇒ il proprietario
    // approva manualmente le richieste; pubblico ⇒ follow immediato.
    function requiresApproval(userId) {
      return !profileIsPublic(userId);
    }

    // Chi richiede è un follower con stato "accepted".
    function isAcceptedFollower(userId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)).data.status == 'accepted';
    }

    // Chi richiede è stato bloccato dal proprietario.
    function isBlockedBy(userId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(userId)/blocked/$(request.auth.uid));
    }

    // Un campo contatore varia di esattamente ±1 (gestisce anche il campo assente = 0).
    function stepsByOne(field) {
      return request.resource.data.get(field, 0) == resource.data.get(field, 0) + 1
          || request.resource.data.get(field, 0) == resource.data.get(field, 0) - 1;
    }

    // Aggiornamento che tocca SOLO uno dei contatori denormalizzati, di ±1.
    // Serve quando segui/smetti di seguire o quando approvi una richiesta:
    // operazioni che modificano il documento di un ALTRO utente.
    function isCounterStep() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn()
        && ( (changed.hasOnly(['followersCount']) && stepsByOne('followersCount'))
           || (changed.hasOnly(['followingCount']) && stepsByOne('followingCount')) );
    }

    // Profili pubblici: discovery + privacy. NESSUN dato sensibile (no email).
    // Leggibili da ogni utente autenticato. Il proprietario gestisce ogni campo;
    // chiunque può però aggiornare i contatori follower/seguiti di un passo ±1.
    match /publicProfiles/{userId} {
      allow read:           if isSignedIn();
      allow create, delete: if isOwner(userId);
      allow update:         if isOwner(userId) || isCounterStep();
    }

    // Sottoalbero personale dell'utente.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Libreria: oltre al proprietario, leggibile se il profilo è pubblico o se
      // sei follower accettato — e mai se sei bloccato. Scrittura solo proprietario.
      match /items/{itemId} {
        allow read: if isOwner(userId)
                     || ( !isBlockedBy(userId)
                          && (profileIsPublic(userId) || isAcceptedFollower(userId)) );
        allow write: if isOwner(userId);
      }

      // Follower: il proprietario gestisce la lista (approva/rimuove); un altro
      // utente può creare/eliminare SOLO il proprio record (seguire/smettere).
      // Se il profilo richiede approvazione il record nasce 'pending'; non si può
      // auto-promuovere ad 'accepted' (update riservato al proprietario).
      match /followers/{followerId} {
        // Il proprietario (e il diretto interessato) vedono ogni stato, incluse
        // le richieste 'pending'. I terzi autorizzati vedono SOLO gli edge
        // 'accepted': le richieste in attesa restano private del proprietario.
        allow read:   if isOwner(userId) || isOwner(followerId)
                       || ( isSignedIn() && !isBlockedBy(userId)
                            && resource.data.status == 'accepted'
                            && (profileIsPublic(userId) || isAcceptedFollower(userId)) );
        allow create: if isOwner(followerId)
                       && !isBlockedBy(userId)
                       && ( (requiresApproval(userId)  && request.resource.data.status == 'pending')
                            || (!requiresApproval(userId) && request.resource.data.status == 'accepted') );
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId) || isOwner(followerId);
      }

      // Seguiti: dati privati del proprietario. Il TARGET può però eliminare il
      // record che lo riguarda: serve per la pulizia quando rimuove un follower
      // o elimina il proprio account (rimozione dei mirror negli alberi altrui).
      match /following/{targetId} {
        // Come per i follower: i terzi autorizzati vedono solo gli edge
        // 'accepted', mai quelli 'pending' (richieste ancora non confermate).
        allow read:           if isOwner(userId)
                               || ( isSignedIn() && !isBlockedBy(userId)
                                    && resource.data.status == 'accepted'
                                    && (profileIsPublic(userId) || isAcceptedFollower(userId)) );
        allow create, update: if isOwner(userId);
        allow delete:         if isOwner(userId) || isOwner(targetId);
      }
      match /blocked/{blockedId} {
        allow read, write: if isOwner(userId);
      }

      // Tutto il resto (profilo privato con email, tag) resta solo del proprietario.
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Riserva globale degli username (unicità).
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userID == request.auth.uid;
      allow update, delete: if isSignedIn()
                    && resource.data.userID == request.auth.uid;
    }
  }
}
