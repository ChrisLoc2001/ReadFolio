rules_version = '2';

// Regole Firebase Storage per le copertine di ReadFolio.
// Ogni utente accede solo alla propria cartella `users/{uid}/covers/`.
//
// Deploy: firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    match /users/{userId}/covers/{coverId} {
      // Lettura: solo il proprietario (i download URL tokenizzati restano comunque
      // utilizzabili dall'app per mostrare l'immagine).
      allow read: if request.auth != null && request.auth.uid == userId;

      // Scrittura: solo il proprietario, solo immagini, max 5 MB.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
