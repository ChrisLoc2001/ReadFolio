// Secrets.xcconfig.example
//
// Copia questo file in `Secrets.xcconfig` (NON versionato) e inserisci le tue chiavi.
//   cp Secrets.xcconfig.example Secrets.xcconfig
//
// Le chiavi vengono iniettate in Info.plist tramite ReadFolio.xcconfig (#include? "Secrets.xcconfig").
// Lascia il valore `la_tua_key` per i servizi che non vuoi configurare:
// l'app rileva il placeholder e tratta la sorgente come "non configurata".

GOOGLE_BOOKS_API_KEY = la_tua_key
COMIC_VINE_API_KEY = la_tua_key
